<Project Sdk="Microsoft.NET.Sdk">

  <!-- The generator sets DebugType and the artifacts path on the command line. -->
  <!-- RootNamespace gives the default namespace record. The extra project imports go into the -->
  <!-- import scope of the project. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Pdb.Rs.Demo</RootNamespace>
    <OptionStrict>On</OptionStrict>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <Import Include="System.Text" />
    <Import Include="Sb = System.Text.StringBuilder" />
  </ItemGroup>

</Project>
