<Project Sdk="Microsoft.NET.Sdk">

  <!-- The generator sets DebugType and the artifacts path on the command line. -->
  <!-- The SDK adds the FSharp.Core package reference implicitly. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>

</Project>
